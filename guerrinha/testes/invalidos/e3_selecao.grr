// E3 - ERROS SEMÂNTICOS NA SELEÇÃO MÚLTIPLA E NO ENCERRAMENTO DE CASO.
// Esperado: expressão float no switch (linha 7), rótulo repetido
//           (linha 9) e break fora de switch/laço (linha 13).
int x = 1;
float y = 1.5;

switch (y) {
    case 1: x = 1; break;
    case 2, 1: x = 2; break;
}

x = 3;
break;
